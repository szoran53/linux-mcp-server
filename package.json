{
  "name": "linux-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Ubuntu/Linux system management via SSH or local execution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "linux-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["mcp", "linux", "ubuntu", "ssh", "system-management", "model-context-protocol"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.21.2",
    "ssh2": "^1.16.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/ssh2": "^1.15.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
